    <string name="permissions_step_location">Precise location</string>
    <string name="permissions_step_location_body">Lets Tarry record where you are while tracking. Allow precise location while using the app.</string>
    <string name="permissions_step_location_degraded">Without precise location nothing can be recorded.</string>
    <string name="permissions_step_background">Location all the time</string>
    <string name="permissions_step_background_body">Lets Tarry start recording at the beginning of your work hours without you opening the app. Choose \"Allow all the time\".</string>
    <string name="permissions_step_background_degraded">Without it, scheduled tracking cannot start by itself.</string>
    <string name="permissions_step_activity">Physical activity</string>
    <string name="permissions_step_activity_body">Lets Tarry notice when you stop or start moving, which saves battery.</string>
    <string name="permissions_step_activity_degraded">Without it, Tarry relies on distance only and uses more battery.</string>
    <string name="permissions_step_notifications">Notifications</string>
    <string name="permissions_step_notifications_body">Shows the tracking status and alerts you if tracking stops unexpectedly.</string>
    <string name="permissions_step_notifications_degraded">Without it, you may not notice that tracking stopped.</string>
    <string name="permissions_step_exact_alarms">Exact alarms</string>
    <string name="permissions_step_exact_alarms_body">Lets Tarry start and stop tracking at the exact start and end of your work hours.</string>
    <string name="permissions_step_exact_alarms_degraded">Without it, tracking may start late or not at all.</string>
    <string name="permissions_step_battery">Battery optimisation</string>
    <string name="permissions_step_battery_body">Stops the system from putting Tarry to sleep while it records.</string>
    <string name="permissions_step_battery_degraded">Without it, the system may pause tracking to save battery.</string>

    <string name="permissions_disclosure_title">Location all the time</string>
    <string name="permissions_disclosure_body">Tarry collects your phone\'s location (latitude, longitude, accuracy and speed) in the background during the work hours you schedule, even when the app is closed. It uses this to work out where you stopped and how you travelled, so you can label visits and trips for invoicing.\n\nThis data is stored only on this phone. It is never uploaded or shared. You can export it yourself at any time.\n\nNext, choose \"Allow all the time\" in the system settings.</string>
    <string name="permissions_disclosure_continue">Continue</string>
    <string name="permissions_disclosure_cancel">Not now</string>

